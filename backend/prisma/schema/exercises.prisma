enum Difficulty {
  EASY
  MEDIUM
  HARD
}

type Blank {
  position Int
  answer   String
  options  String[]
}

model Exercise {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  topic      String
  level      Level
  difficulty Difficulty @default(EASY)
  sentence   String     @unique

  blanks      Blank[]
  explanation String   @default("")
  tags        String[]

  // Links this exercise to GrammarRule.slug(s) so completing it updates
  // UserTopicMastery for the right curriculum topic. Usually one slug,
  // but an exercise can train more than one topic at once.
  topicSlugs  String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level, difficulty])
  @@index([topic])
  @@index([topicSlugs])
}
