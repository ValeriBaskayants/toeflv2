
model MultipleChoice {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId

  question     String     @unique
  options      String[]
  correctIndex Int
  explanation  String     @default("")

  topic        String     @default("")
  level        Level
  difficulty   Difficulty @default(EASY)

  topicSlugs   String[]   @default([])  // GrammarRule.slug(s) this question trains

  isAvailableForPlacement Boolean @default(false)
  category                String  @default("")
  difficultyRating        Float   @default(0)
  discriminationRating    Float   @default(1)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([level, difficulty])
  @@index([topic])
  @@index([topicSlugs])
  @@index([isAvailableForPlacement, category])
}