enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_IN_THE_BLANK
}

model ReadingMaterial {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  title            String        @unique
  slug             String        @unique 
  description      String?       
  
  content          String        
  contentBlocks    Json?         

  level            Level         
  topic            String        // thematic topic of the text, e.g. "Science", "University Life"
  tags             String[]

  // Curriculum grammar tags — which GrammarRule.slug(s) this text exercises.
  // Distinct from `topic` above (thematic) — a text can be "about Science"
  // (topic) while training "Present Simple" and "Articles" (grammarTopics).
  grammarTopics    String[]      @default([])

  wordCount        Int           @default(0)
  estimatedMinutes Int           @default(3)

  coverImageUrl    String?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  questions        QuestionEmbedded[]
  vocabulary       VocabularyEmbedded[]

  @@index([level, topic])
  @@index([grammarTopics])
}

type VocabularyEmbedded {
  word              String
  translation       String
  contextSentence   String?
}

type QuestionEmbedded {
  type              QuestionType   @default(MULTIPLE_CHOICE)
  text              String
  explanation       String?
  options           QuestionOptionEmbedded[]
}

type QuestionOptionEmbedded {
  text       String
  isCorrect  Boolean @default(false)
}
