enum ScrambleMode {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum ScrambleSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ScrambleBlockStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum GrammarRole {
  SUBJECT
  VERB
  OBJECT
  ADJECTIVE
  ADVERB
  PREPOSITION
  CONJUNCTION
  DETERMINER
  COMPLEMENT
  OTHER
}

type ScrambleWord {
  id                String
  word              String
  role              GrammarRole
  position          Int
  isDistractor      Boolean     @default(false)
  requiresUserInput Boolean     @default(false)
  isFixed           Boolean? 
}

type ScrambleAttempt {
  attemptNumber  Int
  submittedOrder String[]
  isCorrect      Boolean
  timeSpentSec   Float
  usedHint       Boolean
  submittedAt    String
}

type FilledBlankAnswer {
  position Int
  text     String
}

type ScrambleAlternative {
  order String[]              
}


type ScrambleBlockResult {
  exerciseId     String
  isCorrect      Boolean
  submittedOrder String[]
  timeSpentSec   Float
  usedHint       Boolean
  answeredAt     String
}

type ScrambleDraftAnswer {
  exerciseId   String
  wordOrder    String[]
  filledBlanks FilledBlankAnswer[]
  usedHint     Boolean             @default(false)
  updatedAt    String
}

model ScrambleExercise {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  prompt      String   @default("")
  sentence    String
  words       ScrambleWord[]
  translation String?
  explanation String?

  level        Level
  topic        String
  topicSlugs   String[] @default([])
  allowedModes ScrambleMode[]

  wordCount       Int
  distractorCount Int @default(0)

  timeLimitEasy   Int @default(60)
  timeLimitMedium Int @default(45)
  timeLimitHard   Int @default(30)
  timeLimitExpert Int @default(25)

  isAvailableForPlacement Boolean @default(false)
  difficultyRating        Float?
  discriminationRating    Float?

  lternatives ScrambleAlternative[]

  sessions ScrambleSession[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([topic])
  @@index([topicSlugs])
  @@index([level, allowedModes])
  @@index([isAvailableForPlacement, difficultyRating])
}

model ScrambleSession {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  userId     String           @db.ObjectId
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String           @db.ObjectId
  exercise   ScrambleExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  mode     ScrambleMode
  status   ScrambleSessionStatus @default(IN_PROGRESS)
  attempts ScrambleAttempt[]
  bestAttempt Int?

  isCorrect    Boolean?
  timeSpentSec Float?
  usedHint     Boolean @default(false)
  finalScore   Int?
  xpEarned     Int?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([userId, exerciseId])
  @@index([userId, status])
}

enum ScrambleBlockKind {
  PRACTICE_SET
  EXAM
}

model ScrambleBlock {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId
  userId      String                @db.ObjectId
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       Level?
  exerciseIds String[]              @db.ObjectId

  draftAnswers  ScrambleDraftAnswer[]
  draftsVersion Int                   @default(0)

  results        ScrambleBlockResult[]
  resultsVersion Int                   @default(0)

  status ScrambleBlockStatus @default(IN_PROGRESS)
  kind   ScrambleBlockKind   @default(EXAM)

  totalTimeBudgetSec Int

  correctCount      Int?
  finalScorePercent Int?
  xpEarned          Int?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, status])
  @@index([userId, level])
}