enum WritingType {
  BUILD_A_SENTENCE
  EMAIL
  ACADEMIC_DISCUSSION
}

enum SubmissionStatus {
  PENDING
  ANALYZED
  ERROR
}

enum WritingSessionStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  ABANDONED
}

type WritingError {
  message      String
  context      String
  offset       Int
  length       Int
  replacements String[]
}

type WritingAnalysis {
  overallScore      Float
  officialBand      Int
  grammarScore      Float
  taskScore         Float
  coherenceScore    Float
  vocabularyScore   Float
  taskSpecificScore Float
  wordCount         Int
  errorCount        Int
  feedback          String?
  detectedTone      String?
  errors            WritingError[]
}

type DiscussionPeerResponse {
  authorName String
  text       String
}

model WritingPrompt {
  id   String      @id @default(auto()) @map("_id") @db.ObjectId
  type WritingType

  prompt String

  discussionPeerResponses DiscussionPeerResponse[]

  level Level
  topic String @default("")

  minWords Int @default(80)
  maxWords Int @default(120)

  timeLimitSec Int @default(420)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions WritingSubmission[]
  sessions    WritingSession[]

  @@index([level, type])
}

model WritingSession {
  id       String        @id @default(auto()) @map("_id") @db.ObjectId
  userId   String        @db.ObjectId
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId String        @db.ObjectId
  prompt   WritingPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  status WritingSessionStatus @default(IN_PROGRESS)

  minWords     Int
  maxWords     Int
  timeLimitSec Int

  submissionId String? @db.ObjectId

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  @@index([userId, promptId])
  @@index([userId, status])
}

model WritingSubmission {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  promptId  String  @db.ObjectId
  prompt    WritingPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  sessionId String? @db.ObjectId

  text         String
  analysis     WritingAnalysis?
  status       SubmissionStatus @default(PENDING)
  timeSpentSec Int?
  submittedAt  DateTime         @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, promptId])
  @@index([userId, status])
}