
enum ScrambleMode {
  EASY    
  MEDIUM  
  HARD    
  EXPERT  
}

enum ScrambleSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum GrammarRole {
  SUBJECT
  VERB
  OBJECT
  ADJECTIVE
  ADVERB
  PREPOSITION
  CONJUNCTION
  DETERMINER
  COMPLEMENT
  OTHER
}

// Одно слово в предложении с грамматической ролью
type ScrambleWord {
  id       String
  word     String
  role     GrammarRole
  position Int          // правильная позиция в предложении (0-based)
  isDistractor Boolean @default(false) // лишнее слово (не входит в ответ)
}

// Результат одной попытки пользователя
type ScrambleAttempt {
  attemptNumber Int
  submittedOrder String[]  // id слов в том порядке как пользователь поставил
  isCorrect     Boolean
  timeSpentSec  Float
  usedHint      Boolean
  submittedAt   String
}

model ScrambleExercise {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId

  // Контент
  sentence    String           // правильное предложение целиком
  words       ScrambleWord[]   // все слова включая distractors
  translation String?          // перевод для подсказки (опционально)
  explanation String?          // объяснение структуры предложения

  // Метаданные
  level       Level
  topic       String           // "present_simple", "conditionals", etc.
  allowedModes ScrambleMode[]

  // Сложность
  wordCount       Int          // слов в правильном ответе
  distractorCount Int @default(0) // лишних слов

  // Тайминг (секунды на выполнение)
  timeLimitEasy   Int @default(60)
  timeLimitMedium Int @default(45)
  timeLimitHard   Int @default(30)
  timeLimitExpert Int @default(25)

  sessions ScrambleSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([topic])
  @@index([level, allowedModes])
}

model ScrambleSession {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId

  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseId String   @db.ObjectId
  exercise   ScrambleExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  mode       ScrambleMode
  status     ScrambleSessionStatus @default(IN_PROGRESS)

  attempts   ScrambleAttempt[]
  bestAttempt Int?              // номер лучшей попытки

  // Результат
  isCorrect   Boolean?
  timeSpentSec Float?
  usedHint    Boolean @default(false)
  finalScore  Int?
  xpEarned    Int?

  startedAt   DateTime @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([userId, exerciseId])
  @@index([userId, status])
}
