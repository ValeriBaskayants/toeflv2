enum GrammarTier {
  FOUNDATION
  ADVANCED
}

model GrammarRule {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  topic       String
  slug        String @unique
  level       Level
  summary     String @default("")
  coreConcept String @default("")
  structure   String @default("")

  usages      Usage[]
  sections    Section[]
  comparisons Comparison[]

  commonMistakes String[]
  signalWords    String[]
  relatedTopics  String[]

  order             Int              @default(0)
  prerequisiteSlugs String[]
  isCore            Boolean          @default(true)
  practiceTargets   PracticeTargets?
  resources         TopicResource[]

  tier              GrammarTier      @default(FOUNDATION)
  sourceAttribution String?
  crossReferences   CrossReference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([level, order])
  @@index([tier, level])
}

type Usage {
  title       String
  explanation String
  examples    Example[]
  letter      String?
  register    String?
}

type Section {
  title    String
  content  String
  examples Example[]
  letter   String?
  register String?
}

type Comparison {
  compareWith String
  explanation String
  examples    Example[]
  letter      String?
}

type Example {
  sentence    String
  translation String?
}

type PracticeTargets {
  grammarRequired    Int @default(5)
  grammarAccuracyMin Int @default(60)
  quizRequired       Int @default(2)
  readingRequired    Int @default(1)
  listeningRequired  Int @default(1)
}

type TopicResource {
  title       String
  url         String
  type        String
  description String?
}

type CrossReference {
  label        String
  targetSlug   String?
  targetAnchor String?
}